local FOLLOW_PLAYER = false -- generated from the recorder FOLLOW toggle
local active = false
local playbackAnchor = CFrame.new()
local activeRoots, byId = {}, {}
local stateCache, frameCursor, cachedPlayerCFrame = {}, 0, CFrame.new()

local function getRootPart()
	local character = player.Character or player.CharacterAdded:Wait()
	return character:WaitForChild("HumanoidRootPart")
end

local function clean()
	for _, model in ipairs(activeRoots) do
		if model and model.Parent then pcall(function() model.Parent = sourceFolder end) end
	end
	activeRoots, byId, stateCache = {}, {}, {}
	frameCursor, cachedPlayerCFrame = 0, CFrame.new()
end

local function prepare(root)
	local allObjects = {root}
	for _, descendant in ipairs(root:GetDescendants()) do allObjects[#allObjects + 1] = descendant end
	for _, obj in ipairs(allObjects) do
		if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide, obj.CanTouch, obj.CanQuery = false, false, false
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Highlight") then
			obj.Enabled = false
		elseif obj:IsA("Sound") then
			pcall(function() obj:Stop() end)
		end
	end
end

local function build()
	clean()
	-- The saved models themselves are moved into Workspace and returned afterward.
	-- This avoids a second expensive Clone() of large VFX hierarchies.
	for _, info in ipairs(DATA.roots) do
		info.model, info.spawned, info.removed = nil, false, false
	end
end

local function spawnRoot(info)
	local model = sourceFolder:FindFirstChild(info.name)
	if not model then
		warn("[VFX Playback] Missing copied model: " .. tostring(info.name))
		info.removed = true
		return
	end
	prepare(model)
	for _, obj in ipairs(model:GetDescendants()) do
		local id = obj:GetAttribute("VFXRecorderId")
		if id then byId[id] = obj end
	end
	local rootId = model:GetAttribute("VFXRecorderId")
	if rootId then byId[rootId] = model end
	model.Parent = workspace
	info.model, info.spawned = model, true
	activeRoots[#activeRoots + 1] = model
end

local function isVFXCarrier(part)
	if not part or not part:IsA("BasePart") then return false end
	for _, d in ipairs(part:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
			return true
		end
	end
	return false
end

local function apply(elapsed)
	if #DATA.frames == 0 then return end
	local index = 1
	while index < #DATA.frames and DATA.frames[index + 1].t <= elapsed do index += 1 end
	while frameCursor < index do
		frameCursor += 1
		local frame = DATA.frames[frameCursor]
		if frame.p then cachedPlayerCFrame = frame.p end
		for _, change in ipairs(frame.s) do
			local id, propIndex, value = change[1], change[2], change[3]
			local props = stateCache[id]
			if not props then props = {}; stateCache[id] = props end
			props[DATA.properties[propIndex]] = value
		end
	end
	local first = DATA.frames[index]
	local second = DATA.frames[math.min(index + 1, #DATA.frames)]
	local alpha = 0
	if second and second.t > first.t then alpha = math.clamp((elapsed - first.t) / (second.t - first.t), 0, 1) end
	local nextChanges = {}
	for _, change in ipairs(second.s or {}) do
		local props = nextChanges[change[1]]
		if not props then props = {}; nextChanges[change[1]] = props end
		props[DATA.properties[change[2]]] = change[3]
	end
	local nextPlayerCFrame = second.p or cachedPlayerCFrame
	local root = getRootPart()
	for id, props in pairs(stateCache) do
		local obj = byId[id]
		if obj and obj.Parent then
			local nextProps = nextChanges[id]
			for property, value in pairs(props) do
				local nextValue = value
				if nextProps and nextProps[property] ~= nil then nextValue = nextProps[property] end
				local ok, result = pcall(function()
					if property == "CFrame" and obj:IsA("BasePart") and typeof(value) == "CFrame" then
						local localA = cachedPlayerCFrame:ToObjectSpace(value)
						local localB = (typeof(nextValue) == "CFrame" and nextPlayerCFrame:ToObjectSpace(nextValue)) or localA
						local target = (FOLLOW_PLAYER and isVFXCarrier(obj)) and root.CFrame or playbackAnchor
						return target * localA:Lerp(localB, alpha)
					elseif property == "Transform" and typeof(value) == "CFrame" and typeof(nextValue) == "CFrame" then
						return value:Lerp(nextValue, alpha)
					elseif typeof(value) == "Vector3" and typeof(nextValue) == "Vector3" then
						return value:Lerp(nextValue, alpha)
					elseif typeof(value) == "number" and typeof(nextValue) == "number" then
						return value + (nextValue - value) * alpha
					end
					return value
				end)
				if ok then pcall(function() obj[property] = result end) end
			end
		end
	end
end

local function play()
	if active then return end
	if #DATA.frames == 0 then warn("No recorded VFX frames") return end
	active = true
	build()
	playbackAnchor = getRootPart().CFrame
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not active then connection:Disconnect() return end
		local elapsed = os.clock() - start
		for _, info in ipairs(DATA.roots) do
			if not info.spawned and not info.removed and elapsed >= info.birth then
				spawnRoot(info)
			end
			if info.model and not info.removed and info.death and elapsed >= info.death then
				info.removed = true
				info.model.Parent = sourceFolder
			end
		end
		apply(elapsed)
		if elapsed >= DATA.duration then
			active = false
			connection:Disconnect()
			clean()
		end
	end)
end

play()
