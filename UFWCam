		camera.FieldOfView = frames[i].fov

		i+=1

	end

	if not frames[i] then

		RunService:UnbindFromRenderStep(
			"CutscenePlayback"
		)

		camera.CameraType =
			Enum.CameraType.Custom

	end
end)
