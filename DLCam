local accumulated = 0
local index = 1
local smoothRootCF = root.CFrame
local cinematicCFrame = camera.CFrame
local cinematicFOV = camera.FieldOfView
local frozen = false
local freezeCFrame
local freezeFOV

local function freezeCamera()
	freezeCFrame = cinematicCFrame
	freezeFOV = cinematicFOV
	frozen = true

	RunService:BindToRenderStep('OvertimeCameraFreeze', Enum.RenderPriority.Last.Value + 1000, function()
		if frozen then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = freezeCFrame
			camera.FieldOfView = freezeFOV
		end
	end)

	task.wait(5)

	frozen = false
	RunService:UnbindFromRenderStep('OvertimeCameraFreeze')
	camera.CameraType = originalCameraType
	camera.CameraSubject = originalCameraSubject
	camera.CFrame = originalCameraCFrame
	camera.FieldOfView = originalCameraFOV
end

task.delay(8, freezeCamera)


RunService:BindToRenderStep('FollowCinematic', Enum.RenderPriority.Camera.Value + 1, function(dt)

	accumulated += dt

	smoothRootCF = root.CFrame

	while frames[index] and accumulated >= frames[index].dt do

		accumulated -= frames[index].dt

		local f = frames[index]

		cinematicCFrame = smoothRootCF * f.cf
		cinematicFOV = f.fov
		camera.CFrame = cinematicCFrame
		camera.FieldOfView = cinematicFOV

		index += 1

	end

	if not frames[index] then
		RunService:UnbindFromRenderStep('FollowCinematic')
		camera.CameraType = Enum.CameraType.Custom
	end

end)
